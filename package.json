{
  "name": "multi-search-engine",
  "displayName": "Multi Search",
  "version": "0.1.0",
  "author": "involvex",
  "description": "Search Google, Bing, DuckDuckGo, and more at once — then pick the best result.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "react",
    "vite",
    "create-chrome-ext"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "bun fmt",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "typecheck": "bun check",
    "prebuild": "bun run format && bun run lint:fix && bun run typecheck",
    "zip": "bun run build && bun src/zip.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "gulp": "^5.0.1",
    "gulp-zip": "^6.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
