# Microsoft Edge Add-ons Update API (v1.1)
# Create credentials in Partner Center → Microsoft Edge → Publish API.
# First listing must be created manually; this API only updates an existing product.

MICROSOFT_CLIENT_ID=
MICROSOFT_API_KEY=

# Product ID from Partner Center → Extension overview (GUID).
# Leave empty until the first listing exists.
# Partner Center export may use ProductID=; the script accepts either name.
EDGE_PRODUCT_ID=
